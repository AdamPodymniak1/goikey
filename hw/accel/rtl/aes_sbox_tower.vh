        tf[6] = x[1] ^ x[2] ^ x[3] ^ x[4] ^ x[6] ^ x[7];
        tf[7] = x[5] ^ x[7];
        ti[0] = x[0] ^ x[2] ^ x[3] ^ x[5] ^ x[6] ^ x[7] ^ 1;
        ti[1] = x[2] ^ x[3] ^ x[6] ^ 1;
        ti[2] = x[0] ^ x[1] ^ x[2] ^ x[3] ^ x[5] ^ x[7] ^ 1;
        ti[3] = x[3] ^ x[4] ^ x[7];
        ti[4] = x[0] ^ x[1] ^ x[2] ^ x[4] ^ x[5] ^ x[6] ^ x[7];
