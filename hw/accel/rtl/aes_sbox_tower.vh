// generated by ref/gen_sbox_tower.py: shared forward / inverse AES S-box in GF(((2^2)^2)^2)
function [1:0] sbt_m4(input [1:0] a, input [1:0] b);
    sbt_m4 = {(a[1] & b[1]) ^ (a[1] & b[0]) ^ (a[0] & b[1]), (a[1] & b[1]) ^ (a[0] & b[0])};
endfunction
function [3:0] sbt_m16(input [3:0] a, input [3:0] b);
    reg [1:0] hh;
    begin
        hh = sbt_m4(a[3:2], b[3:2]);
        sbt_m16 = {hh ^ sbt_m4(a[3:2], b[1:0]) ^ sbt_m4(a[1:0], b[3:2]), sbt_m4(hh, 2'd2) ^ sbt_m4(a[1:0], b[1:0])};
    end
endfunction
function [3:0] sbt_inv16(input [3:0] a);
    case (a)
    4'd0: sbt_inv16 = 4'd0;
    4'd1: sbt_inv16 = 4'd1;
    4'd2: sbt_inv16 = 4'd3;
    4'd3: sbt_inv16 = 4'd2;
    4'd4: sbt_inv16 = 4'd15;
    4'd5: sbt_inv16 = 4'd12;
    4'd6: sbt_inv16 = 4'd9;
    4'd7: sbt_inv16 = 4'd11;
    4'd8: sbt_inv16 = 4'd10;
    4'd9: sbt_inv16 = 4'd6;
    4'd10: sbt_inv16 = 4'd8;
    4'd11: sbt_inv16 = 4'd7;
    4'd12: sbt_inv16 = 4'd5;
    4'd13: sbt_inv16 = 4'd14;
    4'd14: sbt_inv16 = 4'd13;
    4'd15: sbt_inv16 = 4'd4;
    default: sbt_inv16 = 4'd0;
    endcase
endfunction
function [7:0] aes_sbox_fi(input [7:0] x, input inv);   // inv=0: S(x), inv=1: S^-1(x)
