        oi[4] = r[1] ^ r[2] ^ r[3] ^ r[4] ^ r[7];
        oi[5] = r[1] ^ r[3] ^ r[4] ^ r[5];
        oi[6] = r[2] ^ r[4] ^ r[5] ^ r[7];
        oi[7] = r[1] ^ r[3] ^ r[4] ^ r[5] ^ r[7];
