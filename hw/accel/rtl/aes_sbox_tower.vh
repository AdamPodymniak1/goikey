        of[4] = r[0] ^ r[1] ^ r[2] ^ r[3] ^ r[4] ^ r[5] ^ r[7];
        of[5] = r[2] ^ r[4] ^ r[5] ^ r[6] ^ 1;
        of[6] = r[4] ^ r[5] ^ 1;
        of[7] = r[2] ^ r[3] ^ r[5];
        oi[0] = r[0] ^ r[4] ^ r[5] ^ r[6] ^ r[7];
        oi[1] = r[4] ^ r[5] ^ r[6] ^ r[7];
